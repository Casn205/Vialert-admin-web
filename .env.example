# Fuente de datos: 'mock' (sin Firebase, datos de ejemplo) o 'firebase'
VITE_DATA_SOURCE=mock

# Firebase (proyecto compartido con la app móvil). Obligatorias si VITE_DATA_SOURCE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false

# Backend (ambulancias-api). Obligatoria si VITE_DATA_SOURCE=firebase
VITE_API_BASE_URL=http://localhost:3000

# Google Maps (se usan desde la Fase 2)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
